# ---------------------------------------------------------------------------
# Option A: PostgreSQL (Render / Neon / Supabase / local Postgres)
# When DATABASE_URL is set it takes priority, and the DB_* values are ignored.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://user:password@host:5432/database
# PGSSL=false            # set false for Render's internal database URL

# ---------------------------------------------------------------------------
# Option B: MySQL (local Docker / Aiven)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stickynotes
DB_USER=root
DB_PASSWORD=change-me
# DB_SSL=false

# Auth
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Public URLs (used for CORS and Google OAuth redirects)
# BACKEND_URL=http://localhost:3001
# FRONTEND_URL=http://localhost:3001
# CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
