{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "frontend/views",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://sticky-notes-pro-ohea.onrender.com/auth/:path*"
    },
    {
      "source": "/notes/:path*",
      "destination": "https://sticky-notes-pro-ohea.onrender.com/notes/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
